{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["custom/clock"],
  "modules-right": [
    "custom/media",
    "custom/updates",
    "network",
    "idle_inhibitor",
    "pulseaudio",
    "cpu",
    "memory",
    "temperature",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 4 }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Helium": "$1",
      "(.*) - NVIM": "$1"
    }
  },

  "custom/clock": {
    "exec": "date +'%a %d · %H:%M' | tr '[:upper:]' '[:lower:]'",
    "interval": 30,
    "tooltip": false
  },

  "custom/media": {
    "exec": "$HOME/.config/waybar/scripts/media.py",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "playerctl --player=playerctld,%any play-pause",
    "on-click-middle": "playerctl --player=playerctld,%any next",
    "on-scroll-up": "playerctl --player=playerctld,%any previous",
    "on-scroll-down": "playerctl --player=playerctld,%any next"
  },

  "custom/updates": {
    "exec": "checkupdates 2>/dev/null | wc -l | sed '/^0$/d; s/$/ upd/'",
    "interval": 1800,
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "foot -e paru"
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname}  {ipaddr}",
    "interval": 10
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "awake",
      "deactivated": "·"
    },
    "tooltip": false
  },

  "pulseaudio": {
    "format": "<span color='#4a4a4a'>vol</span> {volume}",
    "format-muted": "muted",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "cpu": {
    "format": "<span color='#4a4a4a'>cpu</span> {usage}",
    "interval": 3,
    "states": { "warning": 70, "critical": 90 },
    "tooltip": false
  },

  "memory": {
    "format": "<span color='#4a4a4a'>mem</span> {percentage}",
    "interval": 5,
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "{temperatureC}<span color='#4a4a4a'>°</span>",
    "interval": 5,
    "tooltip": false
  },

  "tray": { "spacing": 12, "icon-size": 14 }
}
