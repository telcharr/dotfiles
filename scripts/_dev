#compdef dev

_dev_templates() {
  local dots=${DOTFILES_DIR:-$HOME/dotfiles}
  local -a shells
  shells=(${(f)"$(find $dots/templates -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"})
  _describe 'shell' shells
}

_dev_composable() {
  local dots=${DOTFILES_DIR:-$HOME/dotfiles}
  local -a langs
  langs=(${(f)"$(sed -n '/toolchains = {/,/^        };/p' $dots/templates/poly/flake.nix 2>/dev/null | sed -n 's/^[[:space:]]*\([a-z][a-z0-9_]*\) = with pkgs;.*/\1/p')"})
  _describe 'language' langs
}

_dev_enabled() {
  local -a langs
  langs=(${(f)"$(python3 -c 'import json,sys
try: d=json.load(open("devshell.json"))
except Exception: raise SystemExit
if isinstance(d,list): d={"languages":d}
print("\n".join(d.get("languages") or []))' 2>/dev/null)"})
  _describe 'enabled language' langs
}

_dev_pkgs() {
  local -a pkgs
  pkgs=(${(f)"$(python3 -c 'import json,sys
try: d=json.load(open("devshell.json"))
except Exception: raise SystemExit
if isinstance(d,list): raise SystemExit
print("\n".join(d.get("packages") or []))' 2>/dev/null)"})
  _describe 'package' pkgs
}

_dev() {
  local -a commands
  commands=(
    'list:available shells'
    'which:active shell, direnv state, toolchain'
    'doctor:diagnose why tooling is not working'
    'shell:enter a shell without writing anything here'
    'attach:persistent shell here, nothing committable added'
    'init:scaffold flake.nix and .envrc here'
    'adopt:add .envrc to an existing flake.nix'
    'switch:replace this directory'\''s shell'
    'add:add a language to a poly shell'
    'rm:remove a language from a poly shell'
    'pkg:add, remove or list extra nixpkgs packages'
    'allow:trust this directory'\''s .envrc'
    'update:update this directory'\''s flake inputs'
    'selftest:run the built-in test suite'
    'help:show usage'
  )

  local curcontext=$curcontext state line
  _arguments -C '1:command:->cmd' '*::arg:->args'

  case $state in
    cmd) _describe 'command' commands ;;
    args)
      case $words[1] in
        shell | attach) _dev_templates ;;
        init | new) _dev_composable ;;
        switch | use) _dev_templates ;;
        add) _dev_composable ;;
        rm | remove) _dev_enabled ;;
        pkg | pkgs)
          if (( CURRENT == 2 )); then
            _values 'subcommand' 'add[add a package]' 'rm[remove a package]' 'list[list packages]'
          elif [[ $words[2] == (rm|remove) ]]; then
            _dev_pkgs
          fi
          ;;
      esac
      ;;
  esac
}

_dev "$@"
